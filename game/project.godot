; Engine configuration file.
; 1 world unit = 1 metre. See docs/SCALE_SHEET.md.

config_version=5

[application]

config/name="Asset31"
config/description="Asset31 vertical slice: the Mantle"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

WorldOrigin="*res://core/world_origin.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/scale_mode="fractional"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0.085, 0.055, 0.035, 1)

[shader_globals]

world_origin={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
retro_snap_resolution={
"type": "vec2",
"value": Vector2(960, 540)
}
retro_snap_strength={
"type": "float",
"value": 1.0
}
